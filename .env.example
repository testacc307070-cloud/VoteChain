# Database connection (PostgreSQL)
DATABASE_URL="postgresql://votechain:votechain_dev@127.0.0.1:5433/votechain?schema=public"

# Application public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email verification (Gmail SMTP / Nodemailer)
EMAIL_USER="votechain.verify@gmail.com"
EMAIL_APP_PASSWORD=""

# Secret for signing HTTP-only session cookies (min 32 characters)
SESSION_SECRET="local-only-demo-session-secret-change-for-real-deployments"

# Master key for ballot AES-256-GCM encryption (min 32 characters)
BALLOT_ENCRYPTION_KEY="local-only-demo-ballot-encryption-key-change-for-real-use"

# Blockchain RPC and contract settings (Ganache or Ethereum testnet)
ETHEREUM_RPC_URL="http://127.0.0.1:8545"
ETHEREUM_ACCOUNT="0x90F8bf6A479f320ead074411a4B0e7944Ea8c9C1"
# Optional private key if not using an unlocked account
ETHEREUM_PRIVATE_KEY=""
# Updated after running npm run blockchain:deploy
VOTECHAIN_CONTRACT_ADDRESS="replace-after-deployment"

# Local DEMO administrator account; never use these credentials outside local testing.
ADMIN_EMAIL="admin@votechain.local"
ADMIN_PASSWORD="adminPassword123!"

# Optional seeded demonstration accounts (min 12 characters each)
VOTER_EMAIL="voter@votechain.local"
VOTER_PASSWORD="voterPassword123!"
OBSERVER_EMAIL="observer@votechain.local"
OBSERVER_PASSWORD="observerPassword123!"
AUTHORITY_EMAIL="authority@votechain.local"
AUTHORITY_PASSWORD="authorityPassword123!"