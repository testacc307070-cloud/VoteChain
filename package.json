{
  "name": "votechain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/unit/*.test.ts tests/contracts/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "blockchain:node": "ganache --wallet.deterministic --server.port 8545",
    "blockchain:deploy": "tsx scripts/deploy-contract.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.17.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.13",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "snarkjs": "^0.7.6",
    "solc": "^0.8.37"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "prisma": "6.12.0",
    "solc": "^0.8.30",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  }
}
